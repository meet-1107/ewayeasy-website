# Public site URL (no trailing slash). REQUIRED before launch.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Verified Google Play listing URL. Leave empty until verified — the site shows a "coming soon" placeholder instead of a guessed link.
NEXT_PUBLIC_PLAY_STORE_URL=
# Support email shown on Contact page. Leave empty until confirmed.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional Web3Forms access key (web3forms.com) so the contact form emails you directly. Empty = the form opens the visitor's email app.
NEXT_PUBLIC_WEB3FORMS_KEY=
# Optional Google Analytics 4 measurement ID (e.g. G-XXXXXXX). Analytics loads only after visitor consent.
NEXT_PUBLIC_GA_ID=
# Optional Microsoft Clarity project ID (clarity.microsoft.com > Settings > Overview). Loads only after visitor consent.
NEXT_PUBLIC_CLARITY_ID=
# Optional Google Search Console verification token.
NEXT_PUBLIC_GSC_VERIFICATION=
